        // 1. Строгий режим
        "use strict";

        // 2. Привет, мир! и Взаимодействие (alert)
        alert("Привет, мир! Добро пожаловать в суровое Средневековье!");

        // 3. Function Expression (Функциональное выражение)
        const workInTavern = function() {
            let earned = 0;
            // 4. Цикл for
            for (let hours = 1; hours <= 3; hours++) {
                earned += 50; // Базовые операторы (математика)
            }
            alert(`Ты мыл посуду 3 часа и заработал ${earned} монет.`);
            return earned;
        };

        // 5. Стрелочные функции, основы
        const stealFromBaron = () => {
            alert("Ты пробрался в замок барона, но стража заметила тебя!");
            return 0; // Возвращаем 0, что приведет к проигрышу
        };

        // 6. Функции (Function Declaration)
        function startQuest() {
            // 7. Переменные (let) и Взаимодействие (prompt)
            let playerName = prompt("Как твое имя, путник?", "");
            
            // 8. Оператор нулевого присваивания '??=' и логический '!'
            // Если нажали "Отмена" (null) или ввели пустую строку, даем имя по умолчанию
            if (!playerName) { 
                playerName ??= "Безымянный бродяга"; 
            }

            // 9. Типы данных (Number, Boolean)
            let balance = 100; 
            let isAlive = true; 

            alert(`Приветствую, ${playerName}! У тебя ${balance} монет.`);

            // 10. Цикл while, Логические операторы (&&) и Операторы сравнения (>, <=)
            while (balance > 0 && balance <= 1000 && isAlive) {
                
                // Взаимодействие (prompt)
                let action = prompt(
                    `Твой баланс: ${balance} монет.\n` +
                    `Выбери действие:\n` +
                    `1. Работать в таверне (+150)\n` +
                    `2. Сыграть в кости (Риск)\n` +
                    `3. Украсть золото барона (Риск)\n` +
                    `4. Сбежать из королевства`
                );

                // 11. Оператор нулевого слияния '??' (если action === null, ставим "4")
                action = action ?? "4"; 

                // 12. Преобразование типов (из строки в число для удобства)
                let choiceNum = Number(action);

                // 13. Конструкция "switch" и Структура кода (блоки case, break)
                switch (choiceNum) {
                    case 1:
                        balance += workInTavern();
                        break;
                    
                    case 2:
                        // Взаимодействие (confirm)
                        let playDice = confirm("Ставка 50 монет. Выиграешь — удвоишь, проиграешь — потеряешь. Играем?");
                        if (playDice) {
                            balance -= 50; 
                            // Генерируем случайное число: 0 или 1
                            let roll = Math.floor(Math.random() * 2); 
                            
                            // 14. Условное ветвление '?' (Тернарный оператор)
                            let won = (roll === 1) ? true : false;
                            
                            // 15. Условное ветвление if...else
                            if (won) {
                                alert("Выпала шестерка! Ты выиграл 100 монет!");
                                balance += 100;
                            } else {
                                alert("Кости показали двойку. Ты проиграл ставку.");
                            }
                        }
                        break;
                    
                    case 3:
                        balance = stealFromBaron(); // Функция возвращает 0
                        break;
                    
                    case 4:
                        isAlive = false; // Прерываем цикл логическим флагом
                        alert("Ты трусливо сбежал в соседнее герцогство.");
                        break;
                    
                    default:
                        alert("Ты бормочешь что-то невнятное. Выбери число от 1 до 4.");
                }
            }

            // Финальная проверка условий победы/поражения (Строгое равенство ===)
            if (balance > 1000) {
                alert(`Корона твоя, ${playerName}! Ты накопил ${balance} монет и купил трон. ДА ЗДРАВСТВУЕТ КОРОЛЬ!`);
            } else if (balance === 0) {
                alert(`Стража схватила тебя на месте преступления с пустыми карманами! Ты брошен в темницу до конца своих дней.`);
            } else {
                alert(`Игра окончена. Твой итоговый капитал: ${balance} монет.`);
            }
        }